#!/usr/bin/env bash
# pre-push — lint before publishing.
# Blocks a push if manifest.webmanifest, sw.js, or index.html are broken.
# The actual checks live in scripts/validate-pwa.sh so CI runs the same gate.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! bash scripts/validate-pwa.sh; then
  echo
  echo "  push blocked. fix the errors above and try again."
  echo "  bypass (not recommended): git push --no-verify"
  exit 1
fi
